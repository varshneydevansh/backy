{
    "name": "@backy-cms/editor",
    "version": "1.0.0",
    "main": "src/index.tsx",
    "types": "src/index.tsx",
    "license": "MIT",
    "scripts": {
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "test:inline-markdown": "tsx scripts/inline-markdown-smoke.ts",
        "test:list-indent": "tsx scripts/list-indent-smoke.ts",
        "test:toolbar-controls": "tsx scripts/toolbar-controls-smoke.ts",
        "test:rich-blocks": "NODE_ENV=production tsx --tsconfig ../../apps/admin/tsconfig.json scripts/rich-blocks-smoke.tsx",
        "test": "npm run test:inline-markdown && npm run test:list-indent && npm run test:toolbar-controls && npm run test:rich-blocks && npm run test:data-figures && npm run test:interactive-components",
        "test:data-figures": "NODE_ENV=production tsx --tsconfig ../../apps/admin/tsconfig.json scripts/data-figures-smoke.tsx",
        "test:interactive-components": "NODE_ENV=production tsx --tsconfig ../../apps/admin/tsconfig.json scripts/interactive-components-smoke.tsx"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "dependencies": {
        "@backy-cms/core": "*",
        "@udecode/plate": "latest",
        "@udecode/plate-basic-marks": "^49.0.0",
        "@udecode/plate-block-quote": "^49.0.0",
        "@udecode/plate-code-block": "^49.0.0",
        "@udecode/plate-alignment": "^49.0.0",
        "@udecode/plate-autoformat": "^48.0.0",
        "@udecode/plate-heading": "^49.0.0",
        "@udecode/plate-link": "^49.0.0",
        "@udecode/plate-list": "^49.0.0",
        "@udecode/plate-math": "^49.0.0",
        "@udecode/plate-font": "^48.0.0",
        "@udecode/plate-indent": "^49.0.0",
        "@udecode/plate-line-height": "^48.0.0",
        "@udecode/plate-selection": "^48.0.5",
        "@udecode/plate-table": "^48.0.6",
        "clsx": "^2.1.0",
        "lucide-react": "^0.300.0",
        "slate": "^0.94.0",
        "slate-history": "^0.93.0",
        "slate-react": "^0.98.0",
        "tailwind-merge": "^2.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "typescript": "^5.0.0"
    },
    "exports": {
        ".": {
            "types": "./src/index.tsx",
            "import": "./src/index.tsx",
            "require": "./src/index.tsx"
        },
        "./rich-text": {
            "types": "./src/RichTextContent.tsx",
            "import": "./src/RichTextContent.tsx",
            "require": "./src/RichTextContent.tsx"
        },
        "./data-figure": {
            "types": "./src/data-figure.ts",
            "import": "./src/data-figure.ts",
            "require": "./src/data-figure.ts"
        }
    }
}
