 const access=load('../src/lib/adminAccess.ts',mocks);const helper=load('../src/lib/adminVisitorPrivacyImpact.ts',{'./adminAccess':access,'./repositoryRuntime':payloadRuntime});
 const route=load('../src/app/api/admin/sites/[siteId]/visitors/members/[memberId]/privacy-impact/route.ts',{'@/lib/adminVisitorPrivacyImpact':helper});
 const state=()=>JSON.stringify({users:[...f.users],settings:f.settings(),members:[...stored],sites:[f.site,f.otherSite]});
 const mutations=()=>JSON.stringify({...f.effects,persistence:[]});let checks=0;
