  for(const cookie of ['',`backy_visitor_other=bkv_${'x'.repeat(43)}`,'backy_admin_session=invalid'])await deny(401,{headers:{cookie}});
  denyCookie=true;await deny(401);denyCookie=false;
  for(const role of ['admin','editor','viewer']){f.actor.role=role as any;await deny(403);}f.actor.role='owner';
  f.actor.role='admin';f.settings().auth.userSiteGrants=[{userId:f.actor.id,scope:{version:1,revision:1,mode:'selected-sites',expiresAt:null,grants:[{siteId:f.site.id,permissions:['sites.view','forms.view']}]}}];await deny(403);await deny(403,{site:f.otherSite.id,id:otherMemberId});f.settings().auth.userSiteGrants=[];f.actor.role='owner';
