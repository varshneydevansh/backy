 const server=createServer(async(req,res)=>{try{const url=new URL(req.url!,'http://'+req.headers.host),parts=url.pathname.split('/'),siteKey=decodeURIComponent(parts[4]),id=decodeURIComponent(parts[7]);const headers=new Headers();for(const[name,value]of Object.entries(req.headers))if(value!==undefined)headers.set(name,Array.isArray(value)?value.join(','):value);const request=new NextRequest(url,{method:req.method,headers});const response=req.method==='GET'?await route.GET(request,{params:Promise.resolve({siteId:siteKey,memberId:id})}):await helper.handleAdminVisitorPrivacyImpact(request,siteKey,id);res.writeHead(response.status,Object.fromEntries(response.headers));res.end(await response.text());}catch{res.writeHead(500);res.end('fixture failure');}});
 await new Promise<void>(resolve=>server.listen(0,'127.0.0.1',resolve));const address=server.address()as{port:number};const base='http://127.0.0.1:'+address.port;
 async function call(options:{site?:string;id?:string;query?:string;headers?:Record<string,string>;method?:string}={}){const url=`${base}/api/admin/sites/${encodeURIComponent(options.site||f.site.id)}/visitors/members/${encodeURIComponent(options.id||memberId)}/privacy-impact${options.query||''}`,headers={origin:base,cookie:'backy_admin_session=owner-fixture-cookie',...options.headers};const response=options.headers?.['content-length']?await new Promise<Response>((resolve,reject)=>{const request=httpRequest(url,{method:'GET',headers},response=>{const chunks:Buffer[]=[];response.on('data',chunk=>chunks.push(chunk));response.on('end',()=>resolve(new Response(Buffer.concat(chunks),{status:response.statusCode,headers:response.headers as Record<string,string>})));});request.on('error',reject);request.end('X');}):await fetch(url,{method:options.method||'GET',headers});const body=await response.json();check(response.headers.get('cache-control')?.includes('private, no-store'),'Private/no-store on every response');if(response.status!==405)assertVisitorPrivacyImpactContract(response.status,body);check(!/PRIVATE_/.test(JSON.stringify(body)),'No private payload/provider/debug data');return{response,body};}
 async function deny(status:number,options:Parameters<typeof call>[0]={}){const before=state(),beforeEffects=mutations(),calls=reviewCalls;const result=await call(options);check(result.response.status===status,'Exact refusal '+status+': '+JSON.stringify(result.body));check(state()===before&&mutations()===beforeEffects,'Refusal performs no persisted mutation/activity/session/credential/delivery');check(reviewCalls===calls,'Refusal before aggregate read');return result;}
 try{
