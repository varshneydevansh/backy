  for(const query of ['?email=PRIVATE_EMAIL','?siteId=other','?limit=20'])await deny(400,{query});await deny(400,{headers:{'content-length':'1'}});await deny(403,{method:'POST'});await deny(404,{id:'bad-id'});await deny(404,{site:'unknown-site'});
  const foreignBefore=state(),foreignCalls=reviewCalls;result=await call({id:otherMemberId});check(result.response.status===404&&reviewCalls===foreignCalls+1&&state()===foreignBefore,'Exact site/member refuses foreign member without mutation');
  if(!input){for(const status of ['suspended','removed']){stored.get(memberId)!.memberStatus=status;result=await call();check(result.response.status===200&&result.body.data.memberStatus===status,'Retained inactive membership can be reviewed');}stored.get(memberId)!.memberStatus='active';f.site.isPublished=false;f.site.settings={visitorAccounts:{enabled:false}}as any;result=await call();check(result.response.status===200,'Unpublished/disabled site review does not require publishing');}
  const adapter=repositories.visitorAccounts.privacyImpact;delete repositories.visitorAccounts.privacyImpact;await deny(503);repositories.visitorAccounts.privacyImpact=adapter;
  failure=true;result=await call();check(result.response.status===503,'Repository failures explicit and safe');failure=false;
  for(const raw of [{...expected,siteId:f.otherSite.id},{...expected,counts:{...expected.counts,comments:-1}},{...expected,boundaries:{...expected.boundaries,erasurePerformed:true}},{...expected,counts:{...expected.counts,formDeliveryAttempts:{total:0,pending:1,unknownOutcome:0}}}]){malformed=raw;result=await call();check(result.response.status===503,'Malformed scope/count/erasure claims fail closed');}malformed=undefined;
  check(networkCalls===0,'No provider network');check(f.effects.writes===0&&f.effects.audits===0&&f.effects.deliveries===0&&f.effects.credentials===0&&f.effects.sessionUpdates===0,'No mutations throughout review/denials');
  check(route.POST===undefined&&route.DELETE===undefined&&route.PATCH===undefined,'Native route exposes GET only');
  const key='PRIVATE_SERVICE_KEY';f.settings().auth.apiKeyServiceKeys=[{id:'read-review-key',keyHash:createHash('sha256').update(key).digest('hex'),scope:{version:1,revision:1,mode:'selected-sites',siteIds:[f.site.id],permissions:['users.view'],expiresAt:null}}];await deny(403,{headers:{'x-backy-admin-key':key}});
  console.log(`Visitor privacy actual HTTP/helper/central-auth PASS ${checks} assertions (${input?'native repository':'isolated aggregate adapter'}); no provider/production actions.`);return{checks};
 }finally{await new Promise<void>((resolve,reject)=>server.close(error=>error?reject(error):resolve()));if(input)repositories.visitorAccounts.privacyImpact=original;}
}
if(process.argv[1]===fileURLToPath(import.meta.url))await verifyVisitorPrivacyImpactHttp();
