import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync } from 'node:fs';
import Ajv2020 from 'ajv/dist/2020.js';
const core=createRequire(import.meta.url)('@backy-cms/core');
const build=core.buildBackyVisitorAccountHandoff;
const disabled=build('site-a'); assert.equal(disabled.policy.enabled,false); assert.equal(disabled.policy.configurationValid,false); assert.equal(disabled.productionProviderProof,'pending');
const enabled=build('site-a',{enabled:true,registrationEnabled:true,allowedOrigins:['https://site.example.com'],returnUrls:['https://site.example.com/account'],providerSecret:'private-secret-marker'});
assert.equal(enabled.policy.enabled,true); assert.equal(enabled.policy.configurationValid,true); assert.equal(enabled.methods.session,'GET'); assert.equal(enabled.endpoints.resetPassword,'/api/sites/site-a/visitor-auth/reset-password'); assert.doesNotMatch(JSON.stringify(enabled),/private-secret-marker/);
assert.equal(enabled.memberManagement.permission,'sites.configure'); assert.equal(enabled.memberManagement.endpoints.list,'/api/admin/sites/site-a/visitors'); assert.match(enabled.memberManagement.removal,/no provider deletion or erasure/);
const malformed=build('site-a',{enabled:true,allowedOrigins:['https://password:secret@site.example.com','https://site.example.com/extra'],returnUrls:['https://site.example.com/account?token=private-marker','javascript:private-marker']});
assert.equal(malformed.policy.configurationValid,false); assert.deepEqual(malformed.policy.allowedOrigins,[]); assert.deepEqual(malformed.policy.returnUrls,[]); assert.doesNotMatch(JSON.stringify(malformed),/private-marker|password:secret/);
const handoff=core.buildCustomFrontendAgentHandoff('site-a',{visitorAccounts:{enabled:true,registrationEnabled:false,allowedOrigins:['https://site.example.com'],returnUrls:['https://site.example.com/account']}});
assert.equal(handoff.visitorAccounts.policy.enabled,true); assert.equal(handoff.visitorAccounts.policy.registrationEnabled,false);
assert.match(handoff.visitorAccounts.identityBoundary,/CMS operator identities are denied/); assert.match(handoff.visitorAccounts.providerBoundary,/global credential/); assert.match(handoff.visitorAccounts.integrationBoundary,/BFF/); assert.match(handoff.visitorAccounts.formsBoundary,/adminOnly/);
for(const relative of ['../src/app/api/sites/[siteId]/agent-handoff/route.ts','../src/app/api/sites/[siteId]/manifest/route.ts']) assert.match(readFileSync(new URL(relative,import.meta.url),'utf8'),/visitorAccounts: (?:input\.)?site\.settings\?\.visitorAccounts/);
console.log('Visitor AI handoff checks passed: disabled/configured policy, secret-safe malformed metadata, auth boundaries, route mirrors.');

assert.equal(enabled.methods.profile,'PATCH'); assert.equal(enabled.endpoints.profile,'/api/sites/site-a/visitor-auth/profile'); assert.deepEqual(enabled.requestFields.profile,['displayName']); assert.match(enabled.integrationBoundary,/Self-service display-name updates/); assert.match(enabled.integrationBoundary,/two-step verified email changes are implemented; privacy erasure remains separate/);
assert.equal(enabled.endpoints.emailChange,'/api/sites/site-a/visitor-auth/email-change'); assert.equal(enabled.endpoints.confirmEmailChange,'/api/sites/site-a/visitor-auth/confirm-email-change');
assert.equal(enabled.methods.emailChange,'POST'); assert.equal(enabled.methods.confirmEmailChange,'POST');
assert.deepEqual(enabled.requestFields.emailChange,['newEmail','currentPassword','returnUrl']); assert.deepEqual(enabled.requestFields.confirmEmailChange,['email','password']);
assert.equal(enabled.emailChange.implementation,'source-implemented'); assert.match(enabled.emailChange.initiation,/revoke all subject sessions\/recovery before provider/); assert.match(enabled.emailChange.callback,/callback\/provider200 alone never means complete/); assert.match(enabled.emailChange.completion,/No enrollment, session creation or persistent pending email\/provider token/);
const manifestSchema=JSON.parse(readFileSync(new URL('../../../specs/ai-frontend-contract/frontend-manifest.schema.json',import.meta.url),'utf8'));
const ajv=new Ajv2020({strict:false,validateFormats:false});ajv.addSchema(manifestSchema);
const validate=ajv.compile({$ref:manifestSchema.$id+'#/$defs/visitorAccountsHandoff'});
assert.ok(validate(enabled),ajv.errorsText(validate.errors));
assert.equal(validate({...enabled,methods:{...enabled.methods,emailChange:'GET'}}),false);
assert.equal(validate({...enabled,emailChange:{...enabled.emailChange,providerToken:'PRIVATE_SENTINEL'}}),false);
